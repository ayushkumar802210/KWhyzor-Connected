# KWhyzor Environment Configuration
# This file contains all required environment variables for the application.
# IMPORTANT: Never commit actual credentials or secrets to the repository.
# Use this file as a template and configure real values in your hosting provider's secure settings.

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these values from your Supabase project dashboard
# Project Settings > API Keys > Project URL and anon/publishable key
# Supabase browser-safe configuration is currently entered in config.js.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# NEVER add the service_role key here - it must remain secret on the server only

# ============================================================================
# SUPER ADMIN CONFIGURATION (CRITICAL - OWNER ONLY)
# ============================================================================
# Configure the email address of the website owner/Super Admin
# ONLY this email address will have access to the Admin Dashboard
# All other registered users will automatically receive the 'user' role
# When a user with this email registers, they are automatically assigned 'super_admin' role

SUPER_ADMIN_EMAIL=ayushkmr802210@gmail.com

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Set to false when Supabase credentials are configured and you want production mode
DEMO_MODE=true

# ============================================================================
# SECURITY RULES
# ============================================================================
# 1. Do NOT hardcode or store the owner's password in this file or anywhere in source code
# 2. Do NOT commit .env files to GitHub (they are in .gitignore)
# 3. Configure all environment variables in your hosting provider's secure settings
# 4. Never share API keys, service-role keys, or admin credentials via email or chat
# 5. The owner must set their password through the secure authentication provider's flow
# 6. All admin functions are protected by server-side role verification in Supabase
# 7. The 'role' field cannot be modified by users through public API endpoints
# 8. Normal users are automatically assigned 'user' role on account creation
# 9. Only the explicitly configured SUPER_ADMIN_EMAIL can become 'super_admin'

# ============================================================================
# DATABASE ROLES (for reference - configured in supabase-schema.sql)
# ============================================================================
# - 'user': Standard account (default for all new registrations)
# - 'super_admin': Administrator access (only the configured owner email)
